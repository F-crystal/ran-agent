[Unit]
Description=Ran Agent Hermes Companion Gateway (port 8642)
After=network-online.target ran-agent-python.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ran_agent
EnvironmentFile=-/opt/ran_agent/.env.local
EnvironmentFile=-/opt/ran_agent/node_bridge/.env.local
EnvironmentFile=-/home/ubuntu/.hermes/.env
UnsetEnvironment=BASH_ENV ENV BASHOPTS SHELLOPTS BASH_XTRACEFD PYTHONHOME PYTHONPATH PYTHONSTARTUP LD_PRELOAD LD_LIBRARY_PATH
Environment=RAN_AGENT_REPO_ROOT=/opt/ran_agent
Environment=HERMES_HOME=/home/ubuntu/.hermes-ran-agent/lite
Environment=HERMES_PROFILE=ran-agent-companion
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_HOST=127.0.0.1
Environment=API_SERVER_PORT=8642
Environment=API_SERVER_MODEL_NAME=ran-agent-companion
Environment=HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
Environment=HERMES_REPLY_MODE=api
Environment=HERMES_REPLY_TIMEOUT_SECONDS=1200
Environment=HERMES_RESTART_DRAIN_TIMEOUT=60
Environment=PYTHON_BACKEND_BASE_URL=http://127.0.0.1:8787
Environment=PYTHON_BACKEND_INGEST_TIMEOUT_MS=5000
Environment=PERSONAL_AGENT_PROACTIVE_ENABLED=false
Environment=PERSONAL_AGENT_REMINDER_DELIVERY_ENABLED=false
Environment=HERMES_PROACTIVE_EVENTS_ENABLED=true
Environment=HERMES_PROACTIVE_EXTERNAL_MCP_ENABLED=true
Environment=HERMES_PROACTIVE_REMINDERS_ENABLED=true
Environment=HERMES_DISABLE_LAZY_INSTALLS=1
Environment=TIRITH_ENABLED=false
Environment=UV_CACHE_DIR=/opt/ran_agent/.ran_agent_state/uv-cache
Environment=UV_TOOL_DIR=/opt/ran_agent/.ran_agent_state/uv-tools
Environment=UV_LINK_MODE=copy
Environment=UV_PYTHON_DOWNLOADS=never
Environment=SOCIAL_READER_GENERIC_FALLBACK_ENABLED=true
Environment=SOCIAL_READER_XHS_BACKEND_TIMEOUT_MS=90000
Environment=SOCIAL_READER_XHS_GENERIC_FALLBACK_TIMEOUT_MS=90000
Environment=XHS_BACKEND_MCP_TIMEOUT_MS=90000
Environment=XHS_PUBLIC_SIDECAR_ENABLED=true
Environment=XHS_PUBLIC_SIDECAR_URL=http://127.0.0.1:18061/xhs/detail
Environment=XHS_PUBLIC_SIDECAR_TIMEOUT_MS=90000
Environment=XHS_PUBLIC_HTML_FALLBACK_ENABLED=true
Environment=XHS_PUBLIC_SIDECAR_MARKER_PATH=/opt/ran_agent/.ran_agent_state/social_reader/xhs-public-sidecar-ready.json
Environment=MEDIA_READER_MCP_TIMEOUT_MS=1200000
Environment=PERSONAL_AGENT_MEDIA_DOWNLOAD_TIMEOUT_MS=60000
Environment=PERSONAL_AGENT_MEDIA_MAX_CONCURRENCY=3
Environment=PERSONAL_AGENT_MEDIA_BATCH_TIMEOUT_MS=1200000
Environment=PERSONAL_AGENT_MEDIA_PER_ITEM_TIMEOUT_MS=120000
Environment=PERSONAL_AGENT_OCR_PROVIDER=dashscope-qwen-vl-ocr
Environment=PERSONAL_AGENT_OCR_MODEL=qwen-vl-ocr-2025-11-20
Environment=PERSONAL_AGENT_OCR_TIMEOUT_MS=120000
Environment=XHS_GENERIC_FALLBACK_MIN_VERSION=1.2.0
ExecStart=/usr/bin/env HERMES_HOME=/home/ubuntu/.hermes-ran-agent/lite HERMES_PROFILE=ran-agent-companion API_SERVER_ENABLED=true API_SERVER_HOST=127.0.0.1 API_SERVER_PORT=8642 API_SERVER_MODEL_NAME=ran-agent-companion HERMES_DISABLE_LAZY_INSTALLS=1 TIRITH_ENABLED=false /opt/ran-agent-runtimes/hermes-v0.20.0-3049a082c0d1/bin/hermes -p ran-agent-companion gateway run --replace --external-supervisor --accept-hooks
Restart=always
RestartSec=5
TimeoutStopSec=240

[Install]
WantedBy=multi-user.target
