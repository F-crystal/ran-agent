            ],
            "cost": {
              "input": 0.293,
              "output": 1.76,
              "cacheRead": 0.293,
              "cacheWrite": 0.293
            },
            "contextWindow": 120000,
            "maxTokens": 8192
          },
          {
            "id": "qwen-image",
            "name": "Claude Settings Image Generation",
            "reasoning": false,
            "input": [
