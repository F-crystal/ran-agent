{
  "gateway": {
    "mode": "local",
    "port": 19123,
    "bind": "loopback",
    "customBindHost": "127.0.0.1",
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true,
          "images": {
            "allowUrl": true
          }
        },
        "responses": {
          "enabled": true
        }
      }
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "enabled": false,
      "allowedOrigins": [
        "http://localhost:19123",
        "http://127.0.0.1:19123"
      ]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/opt/ran_agent",
      "skipBootstrap": true,
      "contextInjection": "continuation-skip",
      "skills": [
        "weather",
        "web-search-live"
      ],
      "userTimezone": "Asia/Shanghai",
      "thinkingDefault": "off",
      "typingMode": "message",
      "timeoutSeconds": 600,
      "llm": {
        "idleTimeoutSeconds": 300
      },
      "contextTokens": 120000,
      "params": {
        "cacheRetention": "short"
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "10m",
        "keepLastAssistants": 3,
        "softTrimRatio": 0.25,
        "hardClearRatio": 0.45,
        "minPrunableToolChars": 12000,
        "softTrim": {
          "maxChars": 4000,
          "headChars": 1500,
          "tailChars": 1500
        },
        "hardClear": {
          "enabled": true,
          "placeholder": "[Old tool result content cleared]"
        },
        "tools": {
          "deny": [
            "browser",
            "canvas"
          ]
        }
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 12000,
        "notifyUser": false
      },
      "blockStreamingDefault": "on",
      "heartbeat": {
        "every": "90m",
        "target": "last",
        "directPolicy": "block",
        "lightContext": true,
        "isolatedSession": true,
        "ackMaxChars": 220,
        "timeoutSeconds": 120,
        "activeHours": {
          "start": "08:30",
          "end": "23:30",
          "timezone": "Asia/Shanghai"
        },
        "prompt": "Read HEARTBEAT.md if it exists (workspace context). Execute due tasks first. Be time-aware and continue tracking todos. If a user-given task or deadline is missing key detail, ask one concise follow-up question. When nothing needs attention, reply HEARTBEAT_OK."
      },
      "model": {
        "primary": "qwen3.5-plus",
        "fallbacks": []
      },
      "cliBackends": {
        "claude-cli": {
          "command": "/usr/bin/claude"
        }
      },
      "models": {}
    },
    "list": [
      {
        "id": "personal-system",
        "default": true,
        "workspace": "/opt/ran_agent",
        "model": {
          "primary": "qwen3.5-plus",
          "fallbacks": []
        },
        "reasoningDefault": "off",
        "identity": {
          "name": "OpenClaw Companion",
          "theme": "life assistant and friend",
          "emoji": "🙂"
        },
        "heartbeat": {
          "every": "90m"
        },
        "tools": {
          "allow": [
            "read",
            "web_search",
            "web_fetch",
            "session_status",
            "exec",
            "process"
          ]
        }
      }
    ]
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "daily",
      "atHour": 4
    },
    "resetByType": {
      "direct": {
        "mode": "daily",
        "atHour": 4
      }
    },
    "resetTriggers": [
      "/new",
      "/reset"
    ]
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "bootstrap-extra-files": {
          "enabled": true,
          "paths": [
            "openclaw/AGENTS.md"
          ]
        }
      }
    }
  },
  "tools": {
    "profile": "coding",
    "allow": [
      "web_search",
      "web_fetch",
      "session_status",
      "exec",
      "process"
    ],
    "web": {
      "fetch": {
        "enabled": true,
        "timeoutSeconds": 30,
        "ssrfPolicy": {
          "allowRfc2544BenchmarkRange": true
        }
      },
      "search": {
        "enabled": true,
        "provider": "tavily",
        "maxResults": 3,
        "timeoutSeconds": 30
      }
    },
    "exec": {
      "host": "gateway",
      "pathPrepend": [
        "/usr/local/bin",
        "/usr/bin",
        "/bin"
      ]
    }
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    },
    "wideArea": {
      "enabled": false
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/ran_agent/.openclaw/extensions"
      ]
    },
    "entries": {
      "tavily": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "${TAVILY_API_KEY}",
            "baseUrl": "https://api.tavily.com"
          }
        }
      },
      "todo-tools": {
        "enabled": false
      },
      "browser": {
        "enabled": false
      },
      "codex": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      }
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "command": "bash",
        "args": [
          "scripts/start_playwright_mcp.sh"
        ]
      },
      "time": {
        "command": "bash",
        "args": [
          "scripts/start_time_mcp.sh"
        ],
        "env": {
          "LOCAL_TIMEZONE": "Asia/Shanghai"
        }
      },
      "media_generation": {
        "command": "bash",
        "args": [
          "scripts/start_media_generation_mcp.sh"
        ]
      },
      "media_reader": {
        "command": "bash",
        "args": [
          "scripts/start_media_reader_mcp.sh"
        ]
      },
      "social_reader": {
        "command": "bash",
        "args": [
          "scripts/start_social_reader_mcp.sh"
        ]
      },
      "mimo_power": {
        "command": "bash",
        "args": [
          "scripts/start_mimo_power_mcp.sh"
        ]
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.4.10",
    "lastTouchedAt": "2026-04-15T12:01:59.417Z"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "claude_code": {
        "baseUrl": "${ANTHROPIC_BASE_URL}",
        "apiKey": "${ANTHROPIC_AUTH_TOKEN}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "qwen3.5-plus",
            "name": "Claude Settings Qwen Frontline",
            "reasoning": false,
            "input": [
              "text",
