              "cacheWrite": 0.117
            },
            "contextWindow": 120000,
            "maxTokens": 8192
          },
          {
            "id": "qwen3.6-plus",
            "name": "Claude Settings Heavy Manual",
            "reasoning": false,
            "input": [
