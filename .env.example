# Ran Agent configuration template.
# Copy to .env.local and fill in your values. .env.local is never committed.

# --- Model Provider (required) ---
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
OPENCLAW_GATEWAY_TOKEN=

# --- Vision / ASR / Media Generation (DashScope) ---
DASHSCOPE_API_KEY=
QWEN_API_KEY=

# --- Web Search ---
TAVILY_API_KEY=

# --- Media Reader: Vision ---
PERSONAL_AGENT_VISION_PROVIDER=dashscope-qwen-vl
PERSONAL_AGENT_VISION_MODEL=qwen3-vl-flash

# --- Media Reader: ASR ---
PERSONAL_AGENT_ASR_PROVIDER=dashscope-asr
PERSONAL_AGENT_ASR_MODEL=qwen3-asr-flash

# --- Media Reader: OCR (best-effort local fallback) ---
PERSONAL_AGENT_OCR_PROVIDER=paddleocr
PERSONAL_AGENT_OCR_ENABLED=true
PERSONAL_AGENT_OCR_REQUIRED=false
PERSONAL_AGENT_OCR_TIMEOUT_MS=15000
PERSONAL_AGENT_PADDLEOCR_COMMAND=paddleocr
FLAGS_use_mkldnn=false
FLAGS_use_onednn=false

# --- Media Reader: Video Processing ---
PERSONAL_AGENT_FFMPEG_PATH=ffmpeg
PERSONAL_AGENT_FFPROBE_PATH=ffprobe
PERSONAL_AGENT_FFMPEG_TIMEOUT_MS=120000

# --- Media Reader: Platform Resolvers ---
PERSONAL_AGENT_PLATFORM_RESOLVERS_ENABLED=true
PERSONAL_AGENT_PLATFORM_RESOLVE_TIMEOUT_MS=15000
PERSONAL_AGENT_PLATFORM_MAX_DURATION_SECONDS=180
PERSONAL_AGENT_YTDLP_PATH=

# --- Media Reader: Bilibili ---
PERSONAL_AGENT_BILIBILI_ENABLED=true
PERSONAL_AGENT_BILIBILI_PROVIDER=auto
PERSONAL_AGENT_YTDLP_PROXY=
PERSONAL_AGENT_BILIBILI_ALLOW_AUTH_COOKIES=false
PERSONAL_AGENT_BILIBILI_SESSDATA_ENV=PERSONAL_AGENT_BILIBILI_SESSDATA
# PERSONAL_AGENT_BILIBILI_SESSDATA=   # never commit
PERSONAL_AGENT_BILIBILI_DOWNLOAD_FOR_ANALYSIS=false
PERSONAL_AGENT_BILIBILI_ANALYSIS_MAX_SECONDS=60
PERSONAL_AGENT_BILIBILI_MCP_COMMAND=
PERSONAL_AGENT_BILIBILI_MCP_ARGS_JSON=

# --- Media Reader: Xiaohongshu ---
PERSONAL_AGENT_XHS_ENABLED=true
PERSONAL_AGENT_XHS_PROVIDER=
PERSONAL_AGENT_XHS_USE_SOCIAL_READER=true
PERSONAL_AGENT_XHS_MCP_COMMAND=
PERSONAL_AGENT_XHS_MCP_ARGS_JSON=
# XHS_COOKIE=   # never commit

# --- Social Reader ---
SOCIAL_PARSE_MCP_COMMAND=
SOCIAL_PARSE_MCP_ARGS_JSON=
SOCIAL_READER_GENERIC_FALLBACK_ENABLED=true
SOCIAL_READER_MCP_TIMEOUT_MS=15000
XHS_MCP_COMMAND=
XHS_MCP_ARGS_JSON=

# --- XHS Browse (Optional, for search/profile/feed) ---
# Main switch
XHS_BROWSE_ENABLED=false

# Backend configuration
XHS_BROWSE_MCP_COMMAND=
XHS_BROWSE_MCP_ARGS_JSON=

# Cookie handling (do NOT store real cookie here)
XHS_BROWSE_MCP_COOKIE_ENV=XHS_COOKIE
# XHS_BROWSE_MCP_COOKIE=   # never commit, use env reference instead

# Timeout and limits
XHS_BROWSE_MCP_TIMEOUT_MS=60000
XHS_BROWSE_MAX_RESULTS=5
XHS_BROWSE_MAX_ITEMS=5
XHS_BROWSE_MIN_INTERVAL_MS=30000
XHS_BROWSE_MAX_CALLS_PER_SESSION=10
XHS_NOTE_TOKEN_CACHE_PATH=.openclaw_state/social_reader/xhs-note-token-cache.json

# Feature-level switches
XHS_BROWSE_SEARCH_ENABLED=true
XHS_BROWSE_NOTE_ENABLED=true
XHS_BROWSE_USER_ENABLED=false
XHS_BROWSE_FEED_ENABLED=false
BILIBILI_MCP_COMMAND=
BILIBILI_MCP_ARGS_JSON=
NETEASE_MUSIC_API_BASE_URL=

# --- Media Reader: Cache & Concurrency ---
PERSONAL_AGENT_MEDIA_READER_ENABLED=true
PERSONAL_AGENT_MEDIA_CACHE_DIR=
PERSONAL_AGENT_MEDIA_MAX_CONCURRENCY=3
PERSONAL_AGENT_MEDIA_BATCH_TIMEOUT_MS=120000
PERSONAL_AGENT_MEDIA_PER_ITEM_TIMEOUT_MS=60000

# --- Backend Qwen (knowledge executor) ---
PERSONAL_AGENT_BACKEND_QWEN_ENABLED=true
PERSONAL_AGENT_QWEN_API_KEY_ENV=QWEN_API_KEY
PERSONAL_AGENT_QWEN_BASE_URL=
PERSONAL_AGENT_QWEN_CHAT_MODEL=
PERSONAL_AGENT_QWEN_TOOLS_MODEL=
PERSONAL_AGENT_QWEN_TIMEOUT_SECONDS=300

# --- Reminder & Notification ---
PERSONAL_AGENT_PROACTIVE_ENABLED=false
PERSONAL_AGENT_REMINDER_DELIVERY_ENABLED=false

# Chromium browser path for Playwright and Puppeteer (xhs-mcp)
# xhs-mcp uses Puppeteer, adapter auto-maps PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH to PUPPETEER_EXECUTABLE_PATH
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/snap/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true  # Adapter sets this by default for xhs-mcp
