# Ran Agent configuration template.
# Copy to .env.local and fill in your values. .env.local is never committed.

# --- Hermes front shell / DeepSeek V4 (default daily chat) ---
NODE_BRIDGE_REPLY_BACKEND=hermes
HERMES_HOME=/Users/fengran/.hermes
HERMES_PROFILE=ran-assistant-lite
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_LITE_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_FULL_API_BASE_URL=http://127.0.0.1:8643/v1
HERMES_LITE_PROFILE=ran-assistant-lite
HERMES_FULL_PROFILE=ran-assistant
RAN_AGENT_CAPABILITY_MODE=auto
HERMES_API_KEY=
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_MODEL_NAME=ran-assistant-lite
API_SERVER_KEY=
HERMES_PROVIDER=deepseek
HERMES_PROVIDER_BASE_URL=https://api.deepseek.com
HERMES_DEFAULT_MODEL=deepseek-v4-flash
HERMES_PRO_MODEL=deepseek-v4-pro
HERMES_INFERENCE_PROVIDER=deepseek
HERMES_INFERENCE_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
RAN_AGENT_REPO_ROOT=/Users/fengran/ran_agent
RAN_AGENT_CONTEXT_POLICY=compact
RAN_AGENT_MAX_MEDIA_ARTIFACTS=3
RAN_AGENT_CONTEXT_SIZE_LOG=1
RAN_AGENT_MULTIMODAL_STRICT_TOOL_MODE=true
HERMES_SESSION_CONTINUITY_ENABLED=true
HERMES_SESSION_ID_PREFIX=ran-agent
HERMES_SESSION_KEY_PREFIX=ran-agent-memory
HERMES_RECENT_TEXT_TURNS=10
HERMES_RECENT_TEXT_CHAR_BUDGET=6000
HERMES_RECENT_TEXT_MAX_USER_CHARS=1200
HERMES_RECENT_TEXT_MAX_ASSISTANT_CHARS=1200
HERMES_GLOBAL_RECENT_TURNS=6
HERMES_GLOBAL_RECENT_CHAR_BUDGET=2500
HERMES_ACTIVE_TOPIC_CHAR_BUDGET=1200
RAN_AGENT_STATE_DIR=/Users/fengran/ran_agent/.ran_agent_state
