CO_READING_TRANSLATION_ENABLED=true
CO_READING_TRANSLATION_PROVIDER=hermes
CO_READING_TRANSLATION_TARGET_LANG=zh-CN

# --- uv / uvx runtime cache ---
UV_CACHE_DIR=/Users/fengran/ran_agent/.ran_agent_state/uv-cache
UV_TOOL_DIR=/Users/fengran/ran_agent/.ran_agent_state/uv-tools
UV_LINK_MODE=copy
UV_PYTHON_DOWNLOADS=never

# --- Obsidian Memory MCP (semantic search via obsidian-index) ---
OBSIDIAN_MEMORY_MCP_ENABLED=false
OBSIDIAN_MEMORY_VAULT_DIR=/Users/fengran/ran_agent/vault
OBSIDIAN_MEMORY_INDEX_PATH=/Users/fengran/ran_agent/data/obsidian-memory-index.duckdb
OBSIDIAN_INDEX_DEVICE=cpu
OBSIDIAN_MEMORY_REINDEX=0
OBSIDIAN_MEMORY_WATCH=0
HF_ENDPOINT=
HF_HOME=
TRANSFORMERS_CACHE=
SENTENCE_TRANSFORMERS_HOME=

# --- MiMo Power MCP: multimodal understanding for DeepSeek text-only chat ---
MIMO_TOKEN_PLAN_API_KEY=
MIMO_TOKEN_PLAN_OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_TOKEN_PLAN_EXPIRES_AT=
