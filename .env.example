# Ran Agent configuration template.
# Copy to .env.local and fill in your values. .env.local is never committed.

# --- Hermes front shell / DeepSeek V4 (default daily chat) ---
NODE_BRIDGE_REPLY_BACKEND=hermes
HERMES_HOME=/Users/fengran/.hermes
HERMES_PROFILE=ran-agent-companion
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_MODEL_NAME=ran-agent-companion
API_SERVER_KEY=
HERMES_PROVIDER=deepseek
HERMES_PROVIDER_BASE_URL=https://api.deepseek.com
HERMES_DEFAULT_MODEL=deepseek-v4-flash
HERMES_PRO_MODEL=deepseek-v4-flash
HERMES_INFERENCE_PROVIDER=deepseek
HERMES_INFERENCE_MODEL=deepseek-v4-flash
HERMES_DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_API_KEY=
PERSONAL_AGENT_HERMES_MODEL=deepseek-v4-flash
RAN_AGENT_REPO_ROOT=/Users/fengran/ran_agent
RAN_AGENT_CONTEXT_POLICY=compact
RAN_AGENT_MAX_MEDIA_ARTIFACTS=3
RAN_AGENT_CONTEXT_SIZE_LOG=1
HERMES_CONTEXT_INJECTION_MODE=auto
HERMES_CONTEXT_CACHE_STRATEGY=balanced
RAN_AGENT_MULTIMODAL_STRICT_TOOL_MODE=true
HERMES_SESSION_CONTINUITY_ENABLED=true
HERMES_SESSION_ID_PREFIX=ran-agent
HERMES_SESSION_KEY_PREFIX=ran-agent-memory
HERMES_RECENT_TEXT_TURNS=4
HERMES_RECENT_TEXT_CHAR_BUDGET=2400
HERMES_RECENT_TEXT_MAX_USER_CHARS=1200
HERMES_RECENT_TEXT_MAX_ASSISTANT_CHARS=1200
HERMES_GLOBAL_RECENT_TURNS=2
HERMES_GLOBAL_RECENT_CHAR_BUDGET=800
HERMES_ACTIVE_TOPIC_CHAR_BUDGET=400
HERMES_CACHE_FRIENDLY_HISTORY=false
HERMES_CACHE_FRIENDLY_HISTORY_MAX_TURNS=6
HERMES_CACHE_FRIENDLY_HISTORY_CHAR_BUDGET=12000
HERMES_CACHE_FRIENDLY_HISTORY_PROFILE=lite
HERMES_CACHE_TELEMETRY_ENABLED=true
HERMES_LITE_SOFT_RESET_ENABLED=true
HERMES_LITE_SOFT_RESET_DRY_RUN=false
HERMES_LITE_SOFT_RESET_MAX_DIGEST_CHARS=1200
HERMES_LITE_SOFT_RESET_KEEP_LAST_N=4
HERMES_LITE_SOFT_RESET_STATE_FILE=.ran_agent_state/hermes/session_maintenance.json
HERMES_LITE_SOFT_RESET_DIGEST_DIR=.ran_agent_state/hermes/digests/
HERMES_ACTION_GATE_ENABLED=true
HERMES_ACTION_GATE_MODE=repair
HERMES_ACTION_GATE_MAX_REPAIR_ATTEMPTS=1
HERMES_ACTION_PENDING_ENABLED=true
HERMES_ACTION_PENDING_TTL_MINUTES=30
HERMES_REPLY_TIMEOUT_SECONDS=1200
NODE_BRIDGE_QUICK_ACK_ENABLED=false
NODE_BRIDGE_QUICK_ACK_TIMEOUT_MS=4500
NODE_BRIDGE_QUICK_ACK_TEXT=收到，正在处理。

# --- External MCP Gateway ---
EXTERNAL_MCP_GATEWAY_ALLOW_ENV_ENABLE=true
EXTERNAL_MCP_GATEWAY_ENABLED=true
EXTERNAL_MCP_SYSTEM_QUEUE_ENABLED=true
EXTERNAL_MCP_ACTIVITY_RUNNER_ENABLED=true
EXTERNAL_MCP_ACTIVITY_TICK_MS=60000
HERMES_PROACTIVE_EVENTS_ENABLED=true
HERMES_PROACTIVE_EXTERNAL_MCP_ENABLED=true
HERMES_PROACTIVE_REMINDERS_ENABLED=true
HERMES_PROACTIVE_NOTIFY_MAX_CHARS=1600

RAN_AGENT_STATE_DIR=/Users/fengran/ran_agent/.ran_agent_state
RAN_AGENT_INTERNAL_CONTROL_SECRET=
# Semantic verification stays off until a real OpenAI-compatible endpoint is
# configured. Ordinary chat does not need it; declared claims and commitments do.
HERMES_SEMANTIC_VERIFIER_ENABLED=false
HERMES_SEMANTIC_VERIFIER_PROVIDER=openai-compatible
HERMES_SEMANTIC_VERIFIER_BASE_URL=
HERMES_SEMANTIC_VERIFIER_MODEL=
HERMES_SEMANTIC_VERIFIER_API_KEY=
HERMES_SEMANTIC_VERIFIER_TIMEOUT_MS=4000
RAN_AGENT_DEFAULT_GLOBAL_USER_ID=user:ran
RAN_AGENT_IDENTITY_MAP_PATH=/Users/fengran/ran_agent/.ran_agent_state/identity-map.json
RAN_AGENT_GLOBAL_TIMELINE_PATH=/Users/fengran/ran_agent/.ran_agent_state/global-timeline.jsonl
RAN_AGENT_TIMELINE_MAX_BYTES=52428800
RAN_AGENT_TIMELINE_MAX_TURNS=5000
RAN_AGENT_TIMELINE_RETENTION_DAYS=30
RAN_AGENT_TIMELINE_COMPACT_ENABLED=true
RAN_AGENT_TIMELINE_ARCHIVE_DIR=/Users/fengran/ran_agent/.ran_agent_state/timeline_archive
FEISHU_BRIDGE_ENABLED=false
FEISHU_LARK_CLI_BIN=lark-cli
FEISHU_LARK_CLI_IDENTITY=bot
FEISHU_EVENT_NAME=im.message.receive_v1
FEISHU_EVENT_TIMEOUT_SECONDS=30
FEISHU_SEND_TIMEOUT_SECONDS=30
FEISHU_DOWNLOAD_TIMEOUT_SECONDS=30
FEISHU_BRIDGE_POLL_INTERVAL_MS=1000
FEISHU_BRIDGE_MAX_RESTARTS=10
DESKTOP_PROXY_ENABLED=false
DESKTOP_PROXY_HOST=127.0.0.1
DESKTOP_PROXY_PORT=8650
DESKTOP_PROXY_API_KEY=
DESKTOP_PROXY_DEFAULT_CLIENT_ID=desktop-local

# --- Python backend / memory ingest ---
PYTHON_BACKEND_BASE_URL=http://127.0.0.1:8787
PYTHON_BACKEND_INGEST_ENABLED=true
PYTHON_BACKEND_INGEST_TIMEOUT_MS=5000

# Courtly attendant persona mode: on (default), off, auto
RAN_AGENT_COURTLY_MODE=on

ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# --- Vision / ASR / Media Generation (DashScope) ---
DASHSCOPE_API_KEY=
QWEN_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_COMPAT_BASE_URL=

# --- Search Hub / Web Search ---
SEARCH_HUB_ENABLED=true
SEARCH_HUB_PROFILE_MODE=auto
SEARCH_HUB_DEFAULT_LIMIT=5
SEARCH_HUB_TIMEOUT_MS=30000
SEARCH_HUB_CACHE_TTL_MS=300000
SEARCH_HUB_CACHE_PATH=/Users/fengran/ran_agent/.ran_agent_state/search_hub/cache.jsonl
SEARCH_HUB_ENABLE_TAVILY=true
SEARCH_HUB_ENABLE_AIHOT=true
SEARCH_HUB_ENABLE_OPENCLI=true
SEARCH_HUB_ENABLE_OPENCLI_BROWSER=false
SEARCH_HUB_ENABLE_PLAYWRIGHT_FALLBACK=false
SEARCH_HUB_OPENCLI_BIN=opencli
SEARCH_HUB_OPENCLI_TIMEOUT_MS=60000
SEARCH_HUB_PUBLIC_ONLY_DEFAULT=true
OPENALEX_MAILTO=
TAVILY_API_KEY=

# --- Co Reading MCP (private shared reading room) ---
CO_READING_ROOT_DIR=/Users/fengran/ran_agent/.ran_agent_state/co_reading
CO_READING_OWNER_TOKEN=
CO_READING_NODE_BIN=node
CO_READING_WEB_ENABLED=false
CO_READING_WEB_HOST=127.0.0.1
CO_READING_WEB_PORT=8787
CO_READING_WEB_ACCESS_TOKEN=
CO_READING_HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
CO_READING_TRANSLATION_ENABLED=true
CO_READING_TRANSLATION_PROVIDER=hermes
CO_READING_TRANSLATION_TARGET_LANG=zh-CN
CO_READING_ASK_CONTEXT_CHARS=1000
CO_READING_ASK_THREAD_LIMIT=6
CO_READING_VAULT_DIR=/Users/fengran/ran_agent/vault

# --- uv / uvx runtime cache ---
UV_CACHE_DIR=/Users/fengran/ran_agent/.ran_agent_state/uv-cache
UV_TOOL_DIR=/Users/fengran/ran_agent/.ran_agent_state/uv-tools
UV_LINK_MODE=copy
UV_PYTHON_DOWNLOADS=never

# --- Media Reader: Vision ---
PERSONAL_AGENT_VISION_PROVIDER=dashscope-qwen-vl
PERSONAL_AGENT_VISION_MODEL=qwen3-vl-flash

# --- Media Reader: ASR ---
PERSONAL_AGENT_ASR_PROVIDER=dashscope-asr
PERSONAL_AGENT_ASR_MODEL=qwen3-asr-flash

# --- Media Reader: OCR ---
PERSONAL_AGENT_OCR_PROVIDER=dashscope-qwen-vl-ocr
PERSONAL_AGENT_OCR_MODEL=qwen-vl-ocr-2025-11-20
PERSONAL_AGENT_OCR_ENABLED=true
PERSONAL_AGENT_OCR_REQUIRED=false
PERSONAL_AGENT_OCR_TIMEOUT_MS=120000
PERSONAL_AGENT_PADDLEOCR_COMMAND=paddleocr
FLAGS_use_mkldnn=false
FLAGS_use_onednn=false

# --- Media Reader: Video Processing ---
PERSONAL_AGENT_FFMPEG_PATH=ffmpeg
PERSONAL_AGENT_FFPROBE_PATH=ffprobe
PERSONAL_AGENT_FFMPEG_TIMEOUT_MS=120000

# --- Media Reader: Platform Resolvers ---
PERSONAL_AGENT_PLATFORM_RESOLVERS_ENABLED=true
PERSONAL_AGENT_PLATFORM_RESOLVE_TIMEOUT_MS=15000
PERSONAL_AGENT_PLATFORM_MAX_DURATION_SECONDS=180
PERSONAL_AGENT_MEDIA_ALLOWED_HOSTS=
PERSONAL_AGENT_TRUSTED_MEDIA_DIRS=
NODE_BRIDGE_TRUSTED_MEDIA_DIRS=
WEIXIN_SDK_INBOUND_MEDIA_DIRS=/tmp/weixin-agent/media/inbound
PERSONAL_AGENT_YTDLP_PATH=

# --- Media Reader: Bilibili ---
PERSONAL_AGENT_BILIBILI_ENABLED=true
PERSONAL_AGENT_BILIBILI_PROVIDER=auto
PERSONAL_AGENT_YTDLP_PROXY=
PERSONAL_AGENT_BILIBILI_ALLOW_AUTH_COOKIES=false
PERSONAL_AGENT_BILIBILI_SESSDATA_ENV=PERSONAL_AGENT_BILIBILI_SESSDATA
# PERSONAL_AGENT_BILIBILI_SESSDATA=   # never commit
PERSONAL_AGENT_BILIBILI_DOWNLOAD_FOR_ANALYSIS=false
PERSONAL_AGENT_BILIBILI_ANALYSIS_MAX_SECONDS=60
PERSONAL_AGENT_BILIBILI_MCP_COMMAND=
PERSONAL_AGENT_BILIBILI_MCP_ARGS_JSON=

# --- Media Reader: Xiaohongshu ---
PERSONAL_AGENT_XHS_ENABLED=true
PERSONAL_AGENT_XHS_PROVIDER=
PERSONAL_AGENT_XHS_USE_SOCIAL_READER=true
# XHS is public-only. Do not configure XHS_COOKIE, QR login, or account-backed MCP.

# --- Social Reader ---
SOCIAL_PARSE_MCP_COMMAND=
SOCIAL_PARSE_MCP_ARGS_JSON=
SOCIAL_READER_GENERIC_FALLBACK_ENABLED=true
SOCIAL_READER_MCP_TIMEOUT_MS=15000
SOCIAL_READER_XHS_BACKEND_TIMEOUT_MS=90000
SOCIAL_READER_XHS_GENERIC_FALLBACK_TIMEOUT_MS=90000
XHS_BACKEND_MCP_TIMEOUT_MS=90000
XHS_GENERIC_FALLBACK_READY_PATH=/Users/fengran/ran_agent/.ran_agent_state/social_reader/generic-fallback-ready.json
XHS_GENERIC_FALLBACK_MIN_VERSION=1.2.0
SOCIAL_READER_ALLOW_RUNTIME_UVX_FALLBACK=false

# --- XHS Public Sidecar (XHS-Downloader API, no account state) ---
XHS_PUBLIC_SIDECAR_ENABLED=true
XHS_PUBLIC_SIDECAR_URL=http://127.0.0.1:18061/xhs/detail
XHS_PUBLIC_SIDECAR_TIMEOUT_MS=90000
XHS_PUBLIC_HTML_FALLBACK_ENABLED=true
XHS_PUBLIC_SIDECAR_MARKER_PATH=/Users/fengran/ran_agent/.ran_agent_state/social_reader/xhs-public-sidecar-ready.json
XHS_PUBLIC_SIDECAR_ROOT_DIR=/Users/fengran/ran_agent/.ran_agent_state/xhs-public-sidecar
BILIBILI_MCP_COMMAND=
BILIBILI_MCP_ARGS_JSON=
NETEASE_MUSIC_API_BASE_URL=

# --- Media Reader: Cache & Concurrency ---
PERSONAL_AGENT_MEDIA_READER_ENABLED=true
PERSONAL_AGENT_MEDIA_CACHE_DIR=
PERSONAL_AGENT_MEDIA_CACHE_TTL_SECONDS=604800
PERSONAL_AGENT_MEDIA_MAX_BYTES=104857600
PERSONAL_AGENT_IMAGE_MAX_BYTES=20971520
PERSONAL_AGENT_AUDIO_MAX_BYTES=52428800
PERSONAL_AGENT_VIDEO_MAX_BYTES=104857600
MEDIA_READER_MCP_TIMEOUT_MS=1200000
PERSONAL_AGENT_MEDIA_DOWNLOAD_TIMEOUT_MS=60000
PERSONAL_AGENT_MEDIA_MAX_CONCURRENCY=3
PERSONAL_AGENT_MEDIA_BATCH_TIMEOUT_MS=1200000
PERSONAL_AGENT_MEDIA_PER_ITEM_TIMEOUT_MS=120000
PERSONAL_AGENT_VIDEO_MAX_FRAMES=12
PERSONAL_AGENT_VIDEO_MAX_SECONDS=180

# --- Backend Qwen (knowledge executor) ---
PERSONAL_AGENT_BACKEND_QWEN_ENABLED=false
PERSONAL_AGENT_QWEN_API_KEY_ENV=DASHSCOPE_API_KEY
PERSONAL_AGENT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/responses
PERSONAL_AGENT_QWEN_CHAT_MODEL=qwen3.5-plus
PERSONAL_AGENT_QWEN_TOOLS_MODEL=qwen3.5-plus
PERSONAL_AGENT_QWEN_TIMEOUT_SECONDS=300
PERSONAL_AGENT_KNOWLEDGE_CRON_HOURS=6,12,18,23
PERSONAL_AGENT_KNOWLEDGE_CRON_MINUTE=0
PERSONAL_AGENT_DAILY_CARRYOVER_ENABLED=true
PERSONAL_AGENT_DAILY_CARRYOVER_HOUR=4
PERSONAL_AGENT_DAILY_CARRYOVER_MINUTE=0

# --- Reminder & Notification ---
PERSONAL_AGENT_PROACTIVE_ENABLED=false
PERSONAL_AGENT_REMINDER_DELIVERY_ENABLED=false
HERMES_PROACTIVE_REMINDERS_ENABLED=true
AI_DAILY_DIGEST_ENABLED=false
AI_DAILY_DIGEST_HOUR=8
AI_DAILY_DIGEST_MINUTE=0

# --- Node bridge / WeChat runtime ---
NODE_BRIDGE_MERGE_WINDOW_MS=1200
NODE_BRIDGE_FALLBACK_TEXT=
NODE_BRIDGE_OUTBOUND_HOST=127.0.0.1
NODE_BRIDGE_OUTBOUND_PORT=8791
NODE_BRIDGE_OUTBOUND_RETRY_DELAY_MS=60000
NODE_BRIDGE_OUTBOUND_SEGMENT_DELAY_MS=1200
WEIXIN_LOGIN_MAX_RETRIES=5
WEIXIN_LOGIN_RETRY_DELAY_MS=1500
WEIXIN_FORCE_LOGIN=false
WEIXIN_RESET_SYNC_ON_START=true
WEIXIN_PREFLIGHT_TIMEOUT_MS=8000
WEIXIN_SKIP_PREFLIGHT=true
WEIXIN_PREFLIGHT_REQUIRED=false
WEIXIN_START_MAX_RETRIES=0
WEIXIN_START_RETRY_DELAY_MS=5000

# Chromium browser path for Playwright and Puppeteer (xhs-mcp)
# xhs-mcp uses Puppeteer, adapter auto-maps PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH to PUPPETEER_EXECUTABLE_PATH
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/snap/bin/chromium
PLAYWRIGHT_MCP_EXECUTABLE_PATH=/snap/bin/chromium
PLAYWRIGHT_MCP_HEADLESS=true
PLAYWRIGHT_MCP_ISOLATED=true
PLAYWRIGHT_MCP_TRANSPORT=stdio
PLAYWRIGHT_MCP_HOST=127.0.0.1
PLAYWRIGHT_MCP_PORT=
PLAYWRIGHT_MCP_USER_DATA_DIR=
PLAYWRIGHT_MCP_STORAGE_STATE=
PLAYWRIGHT_MCP_CAPS=
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true  # Adapter sets this by default for xhs-mcp
